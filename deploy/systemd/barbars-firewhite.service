[Unit]
Description=Варвары — агент fire white ii (второй аккаунт)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=barbars
Group=barbars
WorkingDirectory=/opt/barbars-agent
Environment=PYTHONPATH=/opt/barbars-agent
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/barbars-agent/.venv/bin/python -u run.py --config config-firewhite.json play
Restart=always
RestartSec=15
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
